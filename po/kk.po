#~ msgid "Run the background process that reacts to GNOME theme changes."
#~ msgstr ""
#~ "GNOME тақырыбының өзгерістеріне жауап беретін фондық процесті іске "
#~ "қосыңыз."

#~ msgid "Refactored icon structure and updated metadata integration."
#~ msgstr ""
#~ "Қайта өңделген белгіше құрылымы және жаңартылған метадеректер "
#~ "интеграциясы."

#~ msgid "Run commands when GNOME theme switches"
#~ msgstr "GNOME тақырыбы ауысқанда пәрмендерді іске қосыңыз"

#~ msgid "theme;switch;gtk;gnome;"
#~ msgstr "тақырып;ауыстыру;gtk;gnome;"

#~ msgid ""
#~ "Switchcraft watches GNOME's color-scheme preference and runs user-defined "
#~ "shell commands when the theme switches between light and dark. It allows "
#~ "you to automate theme-dependent adjustments for applications that don't "
#~ "follow system settings automatically."
#~ msgstr ""
#~ "Switchcraft GNOME түс схемасының таңдауын бақылайды және тақырып ашық "
#~ "және қараңғы арасында ауысқанда пайдаланушы анықтайтын қабық пәрмендерін "
#~ "іске қосады. Ол жүйе параметрлерін автоматты түрде орындамайтын "
#~ "қолданбалар үшін тақырыпқа байланысты реттеулерді автоматтандыруға "
#~ "мүмкіндік береді."
