msgstr "Тұрақты атауы (мысалы, D2DL_SCHEMA)"

#: src/ConstantsWindow.vala:210
msgid "Value (e.g., org.gnome.shell.extensions.dash2dock-lite)"
msgstr "Мән (мысалы, org.gnome.shell.extensions.dash2dock-lite)"

#: src/ConstantsWindow.vala:216
msgid ""
"Use in commands as $NAME or ${NAME}. Names use letters, numbers and "
"underscores."
msgstr ""
"Пәрмендерде $NAME немесе ${NAME} ретінде пайдаланыңыз. Атаулар әріптерді,"
" сандарды және астын сызуды пайдаланады."

