== load
{
  "D2DL_SCHEMA" : "org.gnome.shell.extensions.dash2dock-lite",
  "A" : "one",
  "with space" : "s",
  "_u" : "${A}-$B",
  "QUOTED" : "\"q\"",
  "Z" : "last",
  "1BAD" : "bad name",
  "HOME_DIR" : "$HOME/x",
  "B" : "two"
}
